# Puerto del servidor Flask
PORT=5050

# --- OpenRouter (proveedor principal y respaldo) ---
# Sacá una llave gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELO=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODELO_RESPALDO=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Gemini (respaldo) ---
# Sacá una llave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# --- Groq (opcional) ---
# Sacá una llave gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=

# --- GitHub (opcional) ---
# Token personal para subir el limite de lecturas de README de 60 a 5,000 por hora.
# https://github.com/settings/tokens (sin permisos marcados)
GITHUB_TOKEN=

# --- Poblacion de El Salvador ---
# Las proporciones salen de Nemotron y se aplican a la poblacion del pais.
# Dejala vacia para usar el total del Censo 2024.
POBLACION_SV=                 # opcional; por defecto 6029976 (población total, Censo 2024)

# Nemotron directo desde NVIDIA (clave gratis en https://build.nvidia.com). Opcional.
NVIDIA_API_KEY=
NVIDIA_MODELO=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODELO_GRANDE=nvidia/nemotron-3-ultra-550b-a55b
